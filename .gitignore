# Sub-project #2: personal photos and intermediate generations stay local (spec 2026-09-27 section 2)
/SourceArt/Character/Photos/
/SourceArt/Character/Reference/
/SourceArt/Character/Mesh/*
!/SourceArt/Character/Mesh/hero_rigged.fbx
!/SourceArt/Character/Mesh/hero_rigged.png
# Roster characters: the VRoid .vrm sources stay local; their converted <Id>/<Id>.fbx + PNGs are committed
/SourceArt/Character/VRoid/*.vrm
# Rodin-generated characters (docs/character/model-steps.md): only the Mixamo-rigged FBX and its texture are committed
/SourceArt/Character/Models/*/*
!/SourceArt/Character/Models/*/*_rigged.fbx
!/SourceArt/Character/Models/*/*_rigged.png
!/SourceArt/Character/Models/*/*_tail.json

# Outfits (docs/character/outfit-steps.md): only the per-body copies, their hide masks and the texture are committed
/SourceArt/Character/Outfits/*/*
!/SourceArt/Character/Outfits/*/*_outfit.fbx
!/SourceArt/Character/Outfits/*/*_outfit.png
!/SourceArt/Character/Outfits/*/*_hide.png

# Sub-project #3: generated terrain maps and downloaded asset packs (rebuilt by Scripts/world)
/SourceArt/World/

SourceArt/World/PolyHaven/
SourceArt/Creatures/*/*.fbm/
# Perfect Susanoo (docs/vfx/sprite-vfx-guide.md): ChatGPT sheets and the rejected/raw generations stay local; the Tripo rig
# (FBX + base colour), the Mixamo clips and Build/ (Scripts/character/build_susanoo.py output, read by setup_susanoo.py) are committed
/SourceArt/Susanoo/Reference/
/SourceArt/Susanoo/Models/*
!/SourceArt/Susanoo/Models/tripo_rig/
/SourceArt/Susanoo/Models/tripo_rig/*.fbm/*
!/SourceArt/Susanoo/Models/tripo_rig/*.fbm/*basecolor*
/SourceArt/Susanoo/Build/*.fbm/
/SourceArt/Susanoo/Anims/*.zip
.superpowers/
